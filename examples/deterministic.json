        { "id": "no-markdown", "type": "notContains", "value": "**" }
      ]
    },
    {
      "id": "refund-timing",
      "input": "When do I get my money back?",
      "actualOutput": "Refunds reach your original payment method 5 to 10 business days after we receive the return.",
